# ==============================================================================
# FACILITY MANAGEMENT TABLEAU DASHBOARD - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. SUPABASE CONFIGURATION
# Note: In new Supabase UI, Publishable Key = Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 2. ONEDRIVE / SHAREPOINT TRACKER SHARE LINKS
# File 1: Event Tracker (Yearly Event Tracker - DT-3 & DT-4)
VITE_EVENT_TRACKER_URL=https://your-sharepoint-url/event-tracker.xlsx

# File 2: Helpdesk Tracker (HELP DESK TRACKER FY 25-26 - Master)
VITE_HELPDESK_TRACKER_URL=https://your-sharepoint-url/helpdesk-tracker.xlsx

# 3. SYNC CONFIGURATION
VITE_SYNC_INTERVAL_MINUTES=5

# 4. OPTIONAL: MICROSOFT GRAPH / AZURE AD APP REGISTRATION (For enterprise token-based sync)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
